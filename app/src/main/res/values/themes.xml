<resources>
    <style name="Theme.Tote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tote_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Tote.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tote_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tote</item>
    </style>
</resources>
