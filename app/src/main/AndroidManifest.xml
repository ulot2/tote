<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Tote never requests INTERNET. Everything stays on the device (Plan §9.6). -->

    <application
        android:name=".ToteApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tote.Splash"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Picker sheet for the tile. Own task, never in recents, so it doesn't pull the vault forward. -->
        <activity
            android:name=".feature.picker.PickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Tote.Picker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Same sheet, opened by autofill's "All entries…". Standard launch mode so the fill result
             reaches the app being filled. -->
        <activity
            android:name=".feature.picker.AutofillPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Tote.Picker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Realistic fields for trying autofill; opened from Settings. -->
        <activity
            android:name=".feature.playground.AutofillPlaygroundActivity"
            android:exported="false"
            android:label="Try autofill"
            android:theme="@style/Theme.Tote"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
